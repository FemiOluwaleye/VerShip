modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
# Fresh deploy env has no node_modules: install + build the frontend, install
# server deps, then start Express (serves website/dist + API + Socket.IO :5000).
build = ["sh", "-c", "cd website && pnpm install --ignore-workspace && pnpm run build && cd ../server && pnpm install --ignore-workspace"]
run = ["sh", "-c", "cd server && node shipone.js"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Server"

[[workflows.workflow]]
name = "Server"

# Build the unified frontend (public + /admin) into website/dist, then start the
# Express server which serves it alongside the API + Socket.IO on port 5000.
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd website && pnpm install --ignore-workspace && pnpm run build && cd ../server && node shipone.js"
waitForPort = 5000

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
