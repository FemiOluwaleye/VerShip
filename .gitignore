# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
build/
*.zip
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
# gh stores its OAuth token here in plain text; only a machine-level
# gitignore covered it before, which does not travel with a clone.
.config/

# Claude Code persistent config (login + transcripts) — persists on the Replit
# filesystem; must never be committed (contains credentials).
.claude/

# Claude / Codex session artifacts (local working notes, not part of the app)
.agents/
how_we_work/
CLAUDE_*.md
CODEX_*.md

# Playwright output
/test-results/
/playwright-report/

# e2e auth fixtures (contain JWTs)
e2e/.auth.json

# Local migration tooling & scratch — not part of the app; legacy_dump.sql
# holds real legacy data and must never be committed.
/attached_assets/
/legacy_dump.sql
/server/import_legacy.js

# DB safety backups — never commit
/db_backups/
