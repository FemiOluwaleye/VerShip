# Export configuration. Data, not code: fix a future leak by adding a line here
# (or to one of the *.txt rule files) and re-running export.sh.

# The single identity every exported commit is authored AND committed by.
# Must be a GitHub noreply address, never a platform or agent identity.
EXPORT_AUTHOR_NAME="Femi Oluwaleye"
EXPORT_AUTHOR_EMAIL="86317014+FemiOluwaleye@users.noreply.github.com"

# The branch exported. The clone is --single-branch, so nothing else is touched.
EXPORT_SOURCE_BRANCH="render-migration"

# Subjects dropped from the history. Anchored at the start of the subject line.
# Their file changes are NOT lost: each kept commit reuses its own original tree,
# so a dropped commit's changes fold forward into the next kept commit.
#
# "Published your App" is Replit's deploy/checkpoint commit (15 of them on this
# branch). They are platform noise, so they are dropped rather than kept as
# empty deploy markers. To keep them instead, move the pattern to
# EXPORT_DEPLOY_SUBJECTS below.
EXPORT_DROP_SUBJECTS='^(Published your App|Saved progress at the end of the loop|Saved your changes before starting work|Transitioned from Plan to Build mode|Checkpoint|Restored to .*|Agent (step|checkpoint))'

# Subjects kept but forced empty (a release marker). Empty here by choice.
EXPORT_DEPLOY_SUBJECTS=''

# Trailer KEYS stripped from every message. Key-regex, not a fixed list: this
# repo carries 5 Replit-* keys that appear exactly once each
# (Replit-Helium-Checkpoint-Created, Replit-Commit-Screenshot-Url,
# Replit-Commit-Event-Id, Replit-Commit-Session-Id, Replit-Commit-Checkpoint-Type)
# which any hand-written list would have missed.
EXPORT_STRIP_TRAILERS='Co-Authored-By|Claude-Session|Codex-Session|Replit-[A-Za-z-]+|Generated-With|Assisted-By'

# Optional: set to 1 to run `pnpm install && pnpm run build` against the export
# as the final verification step. Off by default because it is slow.
EXPORT_VERIFY_BUILD=0
